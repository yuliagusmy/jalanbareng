# ===========================================
# APPLICATION
# ===========================================
APP_NAME="Jalan Bareng"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.jalanbareng.net
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# ===========================================
# DATABASE
# ===========================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jalan_bareng
DB_USERNAME=postgres
DB_PASSWORD=

# ===========================================
# CACHE & SESSIONS
# ===========================================
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.jalanbareng.net

# ===========================================
# QUEUE
# ===========================================
QUEUE_CONNECTION=redis

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===========================================
# MAIL (Optional)
# ===========================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@jalanbareng.net"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# FRONTEND & CORS
# ===========================================
FRONTEND_URL=https://jalanbareng.net
SANCTUM_STATEFUL_DOMAINS=jalanbareng.net,www.jalanbareng.net

# ===========================================
# GOOGLE OAUTH
# ===========================================
GOOGLE_CLIENT_ID=494198516916-j6kdn11b8mngri8993imjv1h0lice392.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=https://api.jalanbareng.net/api/auth/google/callback

# ===========================================
# NUXT FRONTEND (Web Container)
# ===========================================
NUXT_PUBLIC_API_BASE=https://api.jalanbareng.net
NUXT_PUBLIC_API_URL=https://api.jalanbareng.net/api
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBXVgI1q1czQp5xbLnLXPnNYs6odmN05z4
NUXT_PUBLIC_GOOGLE_MAPS_MAP_ID=a85e7078f15506ea313d002f

# ===========================================
# DOCKER PORTS (Host Exposed Ports)
# ===========================================
BACKEND_PORT=8001
WEB_PORT=3000
REDIS_PORT=6380

# ===========================================
# LOGGING
# ===========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ===========================================
# BROADCASTING (Optional)
# ===========================================
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# ===========================================
# FILESYSTEM (Optional)
# ===========================================
FILESYSTEM_DISK=local

# ===========================================
# AWS S3 (Optional - jika pakai S3 untuk storage)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# VITE (Build)
# ===========================================
VITE_APP_NAME="${APP_NAME}"
